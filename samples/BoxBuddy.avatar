  "mouth": {
    "style": "smile",
    "offsetY": 28,
    "width": 44,
    "height": 11,
    "curvature": 0.75,
    "color": "#12224a"
  },
  "expressions": {
    "idle": {
      "speed": 1,
      "intensity": 1,
      "loop": "infinite",
      "include": true
    },
    "happy": {
      "speed": 1,
      "intensity": 1,
      "loop": "infinite",
      "include": true
    },
